# Base URL of the tender API. After the App Runner -> Lambda migration this is
# the API Gateway HTTP API invoke URL (or its custom domain), e.g.
#   https://abc123.execute-api.eu-west-3.amazonaws.com
# IMPORTANT: no trailing slash — service paths already start with "/" (e.g. /search,
# /get-tender, /search/history, /user/search), so a trailing slash would produce "//".
NEXT_PUBLIC_GET_TENDERS_URL=https://your-api-id.execute-api.eu-west-3.amazonaws.com

# Separate "set user" endpoint (its own Lambda/Function URL — NOT the tender API).
# Unchanged by the App Runner -> Lambda migration; the whole URL is used as-is.
NEXT_PUBLIC_SET_USER_URL=http://www.testurl.test/

# Swagger/OpenAPI spec URL shown on the /api-docs page. Point it at the API
# Gateway openapi.json. NOTE: with the light/heavy Lambda split, the spec served
# by the light API does not list POST /search.
NEXT_PUBLIC_OPENAPI_URL=https://your-api-id.execute-api.eu-west-3.amazonaws.com/openapi.json

NEXT_PUBLIC_COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=your-region
NEXT_PUBLIC_COGNITO_DOMAIN=your-cognito-domain.auth.your-region.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://d84l1y8p4kdic.cloudfront.net